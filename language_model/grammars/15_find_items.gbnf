root   ::= array "\n" "`"

val ::= "{" ws "\"name\"" ":" ws shortstring "," ws "\"obtain_action\"" ":" ws youstring "," ws "\"description\"" ":" ws string "}" ws

array ::= "[" ws (val)? ( "," ws val )? ( "," ws val )? "]"

string ::=
  "\"" (
    [a-zA-Z ]
  )+ "\"" ws

shortstring ::=
  "\"" (
    [a-zA-Z ]
  )+ "\"" ws

youstring ::=
  "\"You " (
    [a-zA-Z, ]
  )+ "\"" ws

number ::=
  [1-9][0-9]* ws

ws ::= [ \t\n]{0,10}